# Port the Node server listens on
PORT=3000
# Where the SQLite database file lives (a Docker volume in production)
DATABASE_PATH=./data/store.db
# Password for the staff dashboard at /staff  (CHANGE THIS)
STAFF_PASSWORD=change-me
# Secret used to sign cookies — use a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string
# Store name shown in the header
STORE_NAME=Corner Store
# Set to "true" only when serving over HTTPS (behind Caddy/nginx with TLS)
COOKIE_SECURE=false
